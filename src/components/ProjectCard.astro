---
import type { ResolvedProject, StatKey } from '../lib/config';
import StatusBadge from './StatusBadge.astro';

export interface Props {
  project: ResolvedProject;
}

const { project } = Astro.props;

const statLabels: Record<StatKey, string> = {
  stars: 'stars',
  forks: 'forks',
  issues: 'issues',
  downloads: 'downloads',
  last_commit: 'updated',
  license: 'license',
  release: 'release',
  languages: 'language',
};

function statPath(key: string, stat: StatKey): string {
  switch (stat) {
    case 'stars':
      return `project.${key}.stars`;
    case 'forks':
      return `project.${key}.forks`;
    case 'issues':
      return `project.${key}.openIssues`;
    case 'downloads':
      return `project.${key}.downloads`;
    case 'last_commit':
      return `project.${key}.lastCommit.date`;
    case 'license':
      return `project.${key}.license`;
    case 'release':
      return `project.${key}.latestRelease.tag`;
    case 'languages':
      return `project.${key}.topLanguage`;
  }
}

const stats = project.stats.slice(0, 5);
const tags = [...project.stack.languages, ...project.stack.frameworks].slice(0, 4);
---

<article
  class="flex flex-col border border-(--color-border-subtle) bg-(--color-surface) p-5 transition-colors hover:border-(--color-border)"
  style="border-radius: var(--radius)"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-[family-name:var(--font-display)] text-xl font-bold uppercase tracking-wide">
      <a href={`/projects/${project.key}`} class="text-(--color-text-head) hover:text-(--color-accent)">
        {project.name}
      </a>
    </h3>
    <StatusBadge status={project.status} archived={project.archived} />
  </div>

  {project.description && (
    <p class="mt-2 text-xs leading-relaxed text-(--color-text-muted)">{project.description}</p>
  )}

  {tags.length > 0 && (
    <div class="mt-3 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <span class="border border-(--color-border-subtle) px-1.5 py-0.5 font-[family-name:var(--font-mono)] text-[9px] text-(--color-text-dim)" style="border-radius: var(--radius)">
          {tag}
        </span>
      ))}
    </div>
  )}

  {stats.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5 border-t border-(--color-border-subtle) pt-3">
      {stats.map((stat) => (
        <span class="inline-flex items-baseline gap-1.5">
          <span
            class="live font-[family-name:var(--font-mono)] text-[11px] text-(--color-text-bright)"
            data-live={statPath(project.key, stat)}
            data-live-fallback={project.fallback[stat] ?? '—'}
          >
            —
          </span>
          <span class="font-[family-name:var(--font-mono)] text-[9px] uppercase tracking-[0.08em] text-(--color-text-dim)">
            {statLabels[stat]}
          </span>
        </span>
      ))}
    </div>
  )}

  <div class="mt-4 flex flex-wrap gap-2 pt-1">
    {project.repo && (
      <a
        href={`https://github.com/${project.repo}`}
        target="_blank"
        rel="noopener noreferrer"
        class="border border-(--color-border) px-2 py-1 font-[family-name:var(--font-mono)] text-[10px] text-(--color-text-muted) hover:border-(--color-text-muted) hover:text-(--color-text-bright)"
        style="border-radius: var(--radius)"
      >
        repo ↗
      </a>
    )}
    <a
      href={`/projects/${project.key}`}
      class="border border-(--color-border) px-2 py-1 font-[family-name:var(--font-mono)] text-[10px] text-(--color-text-muted) hover:border-(--color-accent) hover:text-(--color-accent)"
      style="border-radius: var(--radius)"
    >
      details →
    </a>
  </div>
</article>
